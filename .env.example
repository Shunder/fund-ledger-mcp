# Set actual values in the platform's secret manager. Values below are placeholders.
DATABASE_URL=postgresql://ROLE:PASSWORD@PRIVATE_HOST:5432/DATABASE
PUBLIC_ORIGIN=https://YOUR-WEB-DOMAIN.invalid
OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
ALLOWED_SUBJECTS=auth0|REPLACE_WITH_USER_ID
WEB_CLIENT_ID=REPLACE_WITH_SPA_CLIENT_ID
PORT=3000
TZ=Asia/Shanghai
# Trusted stdio only. Use the same allowlisted subject as in the remote session.
STDIO_SUBJECT=
# Always-on HTTP service runs the Shanghai scheduler; false when using an external cron.
SCHEDULER_ENABLED=true
